APP_NAME=Tenancey
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://tenancey.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tenancey
DB_USERNAME=root
DB_PASSWORD=docker

# Multi-tenancy (stancl/tenancy). Tenants live at {subdomain}.CENTRAL_DOMAIN.
CENTRAL_DOMAIN=tenancey.test
TENANT_DATABASE_PREFIX=tenancey_
TENANT_DB_USER_PREFIX=
# base64:... key for tenants.db_password; empty = APP_KEY
TENANT_DB_KEY=
IMPERSONATION_SESSION_MINUTES=60

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tenancey.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO (S3-compatible), the `minio` container. FILESYSTEM_DISK=minio uses it; production uses s3 + AWS_*.
# PHP reaches it as minio:9000; signed links are made for the browser's address, through Traefik.
MINIO_ENDPOINT=http://minio:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=https://s3.tenancey.test

TENANT_BUCKET_PREFIX=tenancey-

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSockets), the `reverb` container. Generate the app id/key/secret with
# `php artisan reverb:install` or any random strings; VITE_REVERB_APP_KEY must equal REVERB_APP_KEY.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Where reverb:start binds inside its container. REVERB_HOST/PORT above: where PHP connects (inside
# Docker). VITE_REVERB_*: where the browser connects (through Traefik), baked in at asset build time.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ws.tenancey.test
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
