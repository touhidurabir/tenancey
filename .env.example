APP_NAME=Tenancey
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Published ports (compose.yaml, bound to 127.0.0.1). Port mode: http://localhost:APP_PORT,
# tenants at http://{subdomain}.localhost:APP_PORT (Chrome or Firefox; Safari can't resolve
# *.localhost). If you change a port, change the URL that uses it too: APP_URL (APP_PORT),
# VITE_REVERB_PORT (FORWARD_REVERB_PORT), MINIO_PUBLIC_ENDPOINT (FORWARD_MINIO_PORT),
# MINIO_CONSOLE_URL (FORWARD_MINIO_CONSOLE_PORT). Rebuild assets after a VITE_* change.
APP_PORT=8000
FORWARD_REVERB_PORT=8080
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001
FORWARD_DB_PORT=3307
MINIO_CONSOLE_URL=http://localhost:9001

# docker-edge mode (HTTPS on tenancey.test through ~/Sites/docker-edge, see docs/DOCKER.md):
# uncomment COMPOSE_FILE and use these values instead of the port-mode ones in this file.
# COMPOSE_FILE=compose.yaml:compose.edge.yaml
# APP_URL=https://tenancey.test
# CENTRAL_DOMAIN=tenancey.test
# SESSION_SECURE_COOKIE=true
# MINIO_PUBLIC_ENDPOINT=https://s3.tenancey.test
# VITE_REVERB_HOST=ws.tenancey.test
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tenancey
DB_USERNAME=root
DB_PASSWORD=docker

# Multi-tenancy (stancl/tenancy). Tenants live at {subdomain}.CENTRAL_DOMAIN.
CENTRAL_DOMAIN=localhost
TENANT_DATABASE_PREFIX=tenancey_
TENANT_DB_USER_PREFIX=
# base64:... key for tenants.db_password; empty = APP_KEY
TENANT_DB_KEY=
IMPERSONATION_SESSION_MINUTES=60

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tenancey.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO (S3-compatible), the `minio` container. FILESYSTEM_DISK=minio uses it; production uses s3 + AWS_*.
# PHP reaches it as minio:9000; signed links are made for the browser's address (MINIO_PUBLIC_ENDPOINT).
MINIO_ENDPOINT=http://minio:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

TENANT_BUCKET_PREFIX=tenancey-

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSockets), the `reverb` container. bin/setup fills the empty app id/key/secret
# with random values; VITE_REVERB_APP_KEY must equal REVERB_APP_KEY.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Where reverb:start binds inside its container. REVERB_HOST/PORT above: where PHP connects (inside
# Docker). VITE_REVERB_*: where the browser connects (the published port, or Traefik in docker-edge
# mode), baked in at asset build time.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
